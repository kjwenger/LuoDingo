# Copy this file to .env and fill in a real value. Never commit .env.
#
# How to get this: log into https://www.duolingo.com in your browser,
# open DevTools (F12) -> Storage/Application -> Cookies -> www.duolingo.com,
# and copy the value of the "jwt_token" cookie.
#
# Username/password login does not work against Duolingo's unofficial API
# (it's bot-gated), so this JWT is the only credential the app needs.
DUOLINGO_JWT_TOKEN=paste-your-jwt-token-here
