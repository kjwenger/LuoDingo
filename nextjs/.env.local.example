# Copy this file to .env.local and fill in a real value. Never commit .env.local.
# (.env* is already gitignored -- see .gitignore.)
#
# This is a server-only secret (read in lib/duolingo/client.ts via "server-only"); it
# never reaches the browser. Same value as rust/.env's DUOLINGO_JWT_TOKEN -- see the
# top-level README's Credentials section for how to extract one from a logged-in
# browser session.
DUOLINGO_JWT_TOKEN=paste-your-jwt-token-here
